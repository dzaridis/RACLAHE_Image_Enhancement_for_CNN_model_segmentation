# Deny everything by default, then allow only what the image needs.
# This guarantees .git, Dockerfile, docker-compose.yml, Demo Materials, IDE
# settings and any local data never end up in the build context.
*

# Runtime files (must match the COPY instructions in the Dockerfile)
!__main__.py
!requirements.txt
!utils/
!LICENSE
!NOTICE
!README.md
!bbox_weights/

# ...minus anything that could sneak back in through the rules above
utils/__pycache__/
**/*.py[cod]
**/.DS_Store
